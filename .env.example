# you need to create a .env file in the root of the project and copy the contents of this file into it
# you can get the OpenAI API key from the OpenAI website

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Langfuse (optional). Create a project at https://cloud.langfuse.com, then copy
# its API keys here. The application still works when these are left unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Database connection used by the Python application
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
