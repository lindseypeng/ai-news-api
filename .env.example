# you need to create a .env file in the root of the project and copy the contents of this file into it
# you can get the OpenAI API key from the OpenAI website

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Database connection used by the Python application
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres